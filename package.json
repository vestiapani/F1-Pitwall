{
  "name": "f1-pitwall",
  "version": "2.8.2",
  "description": "F1 Remote — Pitwall Control Panel",
  "author": "VestiaPani <ivan131335@gmail.com>",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@racehub-io/f1-telemetry-client": "^0.2.12",
    "socket.io": "^4.8.3",
    "vigemclient": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vestiapani.f1pitwall",
    "productName": "F1 Pitwall",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
